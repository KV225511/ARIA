      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Replaying old answers can evaluate a belief model on stored evidence.\nIt cannot show how candidates would answer different questions chosen by a new policy.\nA saved metric is evidence for its stated experiment, not for the whole deployed system.",
      "fontSize": 17,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
