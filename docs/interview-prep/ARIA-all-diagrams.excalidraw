      "versionNonce": 493,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1,
      "link": null,
      "locked": false,
      "text": "Illustrative belief [0.33, 0.33, 0.34] = uncertain; [0.05, 0.20, 0.75] = stronger Expert belief.\nA good SQL answer should update SQL evidence, not prove competence in every skill.\nLow uncertainty alone is not enough: require coverage and evaluate correctness.",
      "fontSize": 17,
      "fontFamily": 2,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "Illustrative belief [0.33, 0.33, 0.34] = uncertain; [0.05, 0.20, 0.75] = stronger Expert belief.\nA good SQL answer should update SQL evidence, not prove competence in every skill.\nLow uncertainty alone is not enough: require coverage and evaluate correctness.",
      "autoResize": true,
      "lineHeight": 1.35
    },
